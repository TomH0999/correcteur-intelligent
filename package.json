{
  "name": "correcteur-intelligent",
  "productName": "Correcteur Intelligent",
  "version": "1.0.0",
  "description": "Correction intelligente d'exercices (BUT Informatique) par IA : maths manuscrits, code, bases de données, réseaux…",
  "main": "src/main/main.js",
  "author": "TomH0999",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.15.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/TomH0999/correcteur-intelligent",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomH0999/correcteur-intelligent.git"
  },
  "build": {
    "appId": "fr.tomh0999.correcteur-intelligent",
    "productName": "Correcteur Intelligent",
    "copyright": "© 2026 TomH0999",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Correcteur-Intelligent-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Correcteur Intelligent",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
