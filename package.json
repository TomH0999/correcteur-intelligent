{
  "name": "correcteur-intelligent",
  "productName": "Correcteur Intelligent",
  "version": "1.4.0",
  "description": "Correction intelligente d'exercices (BUT Informatique) par IA : maths manuscrits, code, bases de données, réseaux…",
  "main": "src/main/main.js",
  "author": "TomH0999",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@tesseract.js-data/fra": "^1.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdfjs-dist": "^4.10.38",
    "pyodide": "^314.0.7",
    "qrcode": "^1.5.4",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/TomH0999/correcteur-intelligent",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomH0999/correcteur-intelligent.git"
  },
  "build": {
    "appId": "fr.tomh0999.correcteur-intelligent",
    "productName": "Correcteur Intelligent",
    "copyright": "© 2026 TomH0999",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/*inline*",
      "!node_modules/@tesseract.js-data/fra/4.0.0/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pyodide/*.map",
      "!node_modules/pyodide/console*.html",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!node_modules/@electric-sql/pglite/dist/*.tar.gz",
      "!node_modules/@electric-sql/pglite/dist/**/*.map",
      "!node_modules/@electric-sql/pglite/dist/*.d.ts",
      "!node_modules/@electric-sql/pglite/dist/*.d.cts"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Correcteur-Intelligent-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Correcteur Intelligent",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TomH0999",
        "repo": "correcteur-intelligent",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/pyodide/**",
      "node_modules/sql.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/tesseract.js/**",
      "src/main/runner-worker.js",
      "src/main/sqlcompat.js"
    ]
  }
}
